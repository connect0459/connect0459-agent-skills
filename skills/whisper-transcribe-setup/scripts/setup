#!/usr/bin/env bash
# setup — build whisper-transcribe and download the default Whisper model.
# Idempotent: safe to re-run.

set -euo pipefail

: "${WHISPER_BIN_DIR:=$HOME/.local/bin}"
: "${WHISPER_MODEL_DIR:=$HOME/.local/share/whisper-transcribe/models}"

MODEL="large-v3-turbo"
RUN_SMOKE_TEST=true

usage() {
    cat <<USAGE
Usage: setup [--model NAME] [--no-smoke-test]

Build the whisper-transcribe Rust binary and download the specified model.

Options:
  --model NAME       Model name to download (e.g. large-v3-turbo, medium.en). Default: large-v3-turbo.
  --no-smoke-test    Skip the post-install smoke test.
  -h, --help         Show this help.

Environment:
  WHISPER_BIN_DIR    Binary install directory. Default: \$HOME/.local/bin.
  WHISPER_MODEL_DIR  Model directory. Default: \$HOME/.local/share/whisper-transcribe/models.
USAGE
}

while [[ $# -gt 0 ]]; do
    case $1 in
        --model)         MODEL="$2"; shift 2 ;;
        --no-smoke-test) RUN_SMOKE_TEST=false; shift ;;
        -h|--help)       usage; exit 0 ;;
        *) printf 'Unknown argument: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
    esac
done

step() { printf '\n==> %s\n' "$1"; }
die()  { printf 'error: %s\n' "$1" >&2; exit 1; }

# ---------------------------------------------------------------------------
# Step 1: prerequisite check
# ---------------------------------------------------------------------------

step "Checking prerequisites"

missing=()
command -v cargo  >/dev/null 2>&1 || missing+=("cargo")
command -v cmake  >/dev/null 2>&1 || missing+=("cmake")
command -v clang  >/dev/null 2>&1 || missing+=("clang")
command -v ffmpeg >/dev/null 2>&1 || missing+=("ffmpeg")
command -v yt-dlp >/dev/null 2>&1 || missing+=("yt-dlp")

if [[ ${#missing[@]} -gt 0 ]]; then
    printf 'Missing prerequisites: %s\n\n' "${missing[*]}" >&2
    printf 'Install hints (macOS):\n' >&2
    printf '  cargo  — curl --proto '"'"'=https'"'"' --tlsv1.2 -sSf https://sh.rustup.rs | sh\n' >&2
    printf '  cmake  — brew install cmake\n' >&2
    printf '  clang  — xcode-select --install\n' >&2
    printf '  ffmpeg — brew install ffmpeg\n' >&2
    printf '  yt-dlp — brew install yt-dlp\n' >&2
    exit 1
fi

printf 'cargo=%s  cmake=%s  clang=%s\n' \
    "$(cargo --version)" \
    "$(cmake --version | head -1)" \
    "$(clang --version | head -1)"

# ---------------------------------------------------------------------------
# Step 2: build Rust binary (skip when already current)
# ---------------------------------------------------------------------------

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
SRC_DIR="$REPO_ROOT/src/whisper-transcribe"
BIN="$WHISPER_BIN_DIR/whisper-transcribe"

[[ -d "$SRC_DIR" ]] || die "Rust source not found at $SRC_DIR — is the repo checked out correctly?"

NEED_BUILD=true
if [[ -x "$BIN" ]]; then
    # Skip build if the installed binary is newer than all source files.
    if ! find "$SRC_DIR/src" "$SRC_DIR/Cargo.toml" "$SRC_DIR/Cargo.lock" -newer "$BIN" 2>/dev/null | grep -q .; then
        step "Binary is up to date; skipping build"
        NEED_BUILD=false
    fi
fi

if [[ "$NEED_BUILD" == "true" ]]; then
    step "Building whisper-transcribe (cargo build --release)"
    cargo build --release --manifest-path "$SRC_DIR/Cargo.toml"

    step "Installing binary to $BIN"
    mkdir -p "$WHISPER_BIN_DIR"
    cp "$SRC_DIR/target/release/whisper-transcribe" "$BIN"
    chmod +x "$BIN"
fi

printf 'binary: %s\n' "$BIN"

# ---------------------------------------------------------------------------
# Step 3: download model
# ---------------------------------------------------------------------------

mkdir -p "$WHISPER_MODEL_DIR"
MODEL_FILE="$WHISPER_MODEL_DIR/ggml-${MODEL}.bin"

if [[ -f "$MODEL_FILE" ]]; then
    step "Model ggml-${MODEL}.bin already present; skipping download"
else
    step "Downloading model ggml-${MODEL}.bin from HuggingFace (~809 MB for large-v3-turbo)"
    HF_URL="https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-${MODEL}.bin"
    TMP_FILE="${MODEL_FILE}.tmp"
    rm -f "$TMP_FILE"
    # Download to a temp file; rename atomically on success so an interrupted
    # download never leaves a partial .bin that would be mistaken for a valid model.
    if curl -L --progress-bar -o "$TMP_FILE" "$HF_URL"; then
        mv "$TMP_FILE" "$MODEL_FILE"
    else
        rm -f "$TMP_FILE"
        die "model download failed"
    fi
fi

printf 'model: %s\n' "$MODEL_FILE"

# ---------------------------------------------------------------------------
# Step 4: smoke tests
# ---------------------------------------------------------------------------

if [[ "$RUN_SMOKE_TEST" != "true" ]]; then
    step "Skipping smoke tests (--no-smoke-test)"
else
    : "${TMPDIR:=/tmp}"
    SMOKE_DIR="$(mktemp -d "${TMPDIR%/}/whisper-setup-smoke.XXXXXXXX")"
    trap 'rm -rf "$SMOKE_DIR"' EXIT

    run_smoke() {
        local wav="$1" kw1="$2" kw2="$3" label="$4" lang="${5:-}"
        local lang_args=()
        [[ -n "$lang" ]] && lang_args=(--language "$lang")

        local transcript
        transcript="$("$BIN" "$wav" --format txt --model "$MODEL" ${lang_args[@]+"${lang_args[@]}"} 2>&1)"
        if printf '%s' "$transcript" | grep -qF "$kw1" && printf '%s' "$transcript" | grep -qF "$kw2"; then
            printf '%s smoke test passed: found "%s" and "%s".\n' "$label" "$kw1" "$kw2"
        else
            printf '%s smoke test FAILED. Transcript:\n----\n%s\n----\n' "$label" "$transcript" >&2
            die "$label smoke test failed — build produced unexpected output"
        fi
    }

    # English: JFK clip from whisper.cpp upstream
    step "Running English smoke test (samples/jfk.wav)"
    JFK_WAV="$SMOKE_DIR/jfk.wav"
    curl -sL "https://github.com/ggml-org/whisper.cpp/raw/master/samples/jfk.wav" -o "$JFK_WAV"
    [[ -s "$JFK_WAV" ]] || die "failed to download jfk.wav smoke test sample"
    run_smoke "$JFK_WAV" "ask" "country" "English"

    # Japanese: generated via macOS say -v Kyoko, converted to 16kHz mono WAV via ffmpeg
    step "Running Japanese smoke test (say -v Kyoko)"
    JA_AIFF="$SMOKE_DIR/ja.aiff"
    JA_WAV="$SMOKE_DIR/ja.wav"
    say -v Kyoko -o "$JA_AIFF" "今日はいい天気ですね。明日も晴れるといいですね。" 2>/dev/null \
        || die "'say -v Kyoko' failed — macOS with Japanese voice required for Japanese smoke test"
    ffmpeg -i "$JA_AIFF" -ar 16000 -ac 1 -f wav "$JA_WAV" -y -loglevel quiet
    run_smoke "$JA_WAV" "天気" "明日" "Japanese" "ja"
fi

# ---------------------------------------------------------------------------
# Done
# ---------------------------------------------------------------------------

cat <<DONE

Setup complete.
  binary: $BIN
  model:  $MODEL_FILE

Next steps:
  /connect0459-agent-skills:youtube-transcribe-local     — transcribe a local file
  /connect0459-agent-skills:youtube-transcribe-transcribe-youtube  — full YouTube → SRT + Markdown
DONE
